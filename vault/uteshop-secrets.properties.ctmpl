{{- with secret "secret/data/uteshop/prod" -}}
DB_URL={{ .Data.data.DB_URL }}
DB_USER={{ .Data.data.DB_USER }}
DB_PASSWORD={{ .Data.data.DB_PASSWORD }}

GOOGLE_CLIENT_ID={{ .Data.data.GOOGLE_CLIENT_ID }}
GOOGLE_CLIENT_SECRET={{ .Data.data.GOOGLE_CLIENT_SECRET }}
GOOGLE_REDIRECT_URI={{ .Data.data.GOOGLE_REDIRECT_URI }}

FIELD_ENCRYPTION_KEY={{ .Data.data.FIELD_ENCRYPTION_KEY }}
JWT_SECRET={{ .Data.data.JWT_SECRET }}

SMTP_HOST={{ .Data.data.SMTP_HOST }}
SMTP_PORT={{ .Data.data.SMTP_PORT }}
SMTP_USERNAME={{ .Data.data.SMTP_USERNAME }}
SMTP_PASSWORD={{ .Data.data.SMTP_PASSWORD }}
SMTP_FROM={{ .Data.data.SMTP_FROM }}
SMTP_FROM_NAME={{ .Data.data.SMTP_FROM_NAME }}
SMTP_STARTTLS={{ .Data.data.SMTP_STARTTLS }}

STRIPE_PUBLISHABLE_KEY={{ .Data.data.STRIPE_PUBLISHABLE_KEY }}
STRIPE_SECRET_KEY={{ .Data.data.STRIPE_SECRET_KEY }}
STRIPE_WEBHOOK_SECRET={{ .Data.data.STRIPE_WEBHOOK_SECRET }}
STRIPE_CURRENCY={{ .Data.data.STRIPE_CURRENCY }}

FORCE_SECURE_COOKIE={{ .Data.data.FORCE_SECURE_COOKIE }}

VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN_FILE=C:/secure/uteshop/vault-agent-token
VAULT_TRANSIT_ENABLED=true
VAULT_TRANSIT_KEY=uteshop-field-encryption
{{- end }}
